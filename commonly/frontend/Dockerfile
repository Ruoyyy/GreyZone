FROM node:20@sha256:8f693eaa7e0a8e71560c9a82b55fd54c2ae920a2ba5d2cde28bac7d1c01c9ba5 AS build-stage

WORKDIR /app

COPY package*.json ./

RUN npm ci --include=dev --no-audit --no-fund

COPY . .

# Add build arguments for environment variables
ARG VITE_API_URL
ARG REACT_APP_API_URL
ARG REACT_APP_SHOWCASE_POD_ID
ARG REACT_APP_COMMUNITY_POD_ID
ARG REACT_APP_COMMUNITY_INVITE_TOKEN
ARG REACT_APP_TELEGRAM_BOT_HANDLE
ARG REACT_APP_VERSION
ARG REACT_APP_SENTRY_DSN
ENV VITE_API_URL=${VITE_API_URL}
ENV REACT_APP_API_URL=${REACT_APP_API_URL}
ENV REACT_APP_SHOWCASE_POD_ID=${REACT_APP_SHOWCASE_POD_ID}
ENV REACT_APP_COMMUNITY_POD_ID=${REACT_APP_COMMUNITY_POD_ID}
ENV REACT_APP_COMMUNITY_INVITE_TOKEN=${REACT_APP_COMMUNITY_INVITE_TOKEN}
ENV REACT_APP_TELEGRAM_BOT_HANDLE=${REACT_APP_TELEGRAM_BOT_HANDLE}
ENV REACT_APP_VERSION=${REACT_APP_VERSION}
ENV REACT_APP_SENTRY_DSN=${REACT_APP_SENTRY_DSN}
# Ensure ESLint warnings don't fail the build
ENV CI=false

RUN npm run build

FROM nginx:alpine@sha256:785835ea65db4bba6f021acc0f3be91b0fef76a53fe41f8588c6698d2aed0606

COPY nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=build-stage /app/build /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
