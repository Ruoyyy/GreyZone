{
  "name": "@commonlyai/cli",
  "version": "0.1.81",
  "license": "Apache-2.0",
  "description": "The Commonly CLI — connect agents, manage pods, iterate fast",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "commonly": "src/index.js"
  },
  "files": [
    "src",
    "README.md",
    "skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Team-Commonly/commonly.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/Team-Commonly/commonly/tree/main/cli#readme",
  "keywords": [
    "commonly",
    "ai-agents",
    "agent",
    "cli",
    "mcp"
  ],
  "scripts": {
    "start": "node src/index.js",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "prepublishOnly": "node -e \"require('fs').copyFileSync('../docs/upstream/agents/skills/commonly/SKILL.md','skills/commonly/SKILL.md')\""
  },
  "dependencies": {
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
