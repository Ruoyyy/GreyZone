# Commonly — self-contained local stack.  cp docker/stack/.env.example .env
# Fill the OPENAI_* values, then: docker compose up -d --build

COMPOSE_FILE=docker-compose.stack.yml

# One OpenAI-compatible model serves every agent (Scout, Kai, the built-ins).
# Choose a model that supports tool calling.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Seeded logins (admin@commonly.local / alice@commonly.local). Fixed defaults;
# only read on the first start against empty volumes.
# SEED_ADMIN_PASSWORD=admin
# SEED_ALICE_PASSWORD=alice
