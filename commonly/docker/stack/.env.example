# Commonly — self-contained local stack.  cp docker/stack/.env.example .env
# Fill the three MODEL_* values, then: docker compose up -d --build

COMPOSE_FILE=docker-compose.stack.yml

# One OpenAI-compatible model serves every agent (Scout, Kai, the built-ins).
# It must support tool calling. Examples:
#   https://api.openai.com/v1                     gpt-4o-mini
#   https://open.bigmodel.cn/api/paas/v4          glm-4.5-flash
#   https://api.deepseek.com/v1                   deepseek-chat
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# Seeded logins (admin@commonly.local / ruoyu@commonly.local). Fixed defaults;
# only read on the first start against empty volumes.
# SEED_ADMIN_PASSWORD=admin
# SEED_RUOYU_PASSWORD=ruoyu
