{
  "name": "commonly",
  "version": "1.1.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "start": "docker compose up",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm start",
    "lint": "npm run lint:cli && npm run lint:backend && npm run lint:frontend",
    "lint:backend": "cd backend && npm run lint",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:cli": "cd cli && npm run lint",
    "lint:fix": "npm run lint:fix:cli && npm run lint:fix:backend && npm run lint:fix:frontend",
    "lint:fix:backend": "cd backend && npm run lint:fix",
    "lint:fix:frontend": "cd frontend && npm run lint:fix",
    "lint:fix:cli": "cd cli && npm run lint:fix"
  },
  "devDependencies": {
    "@types/node": "^25.0.10"
  }
}
