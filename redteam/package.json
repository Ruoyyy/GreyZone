{
  "name": "redteam-promptfoo-mcp",
  "private": true,
  "type": "module",
  "description": "Promptfoo target provider that maps attacks to Gitea issues/comments via MCP",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "smoke": "node ./scripts/smoke_provider.mjs",
    "redteam": "PROMPTFOO_CONFIG_DIR=$PWD/.promptfoo PROMPTFOO_DISABLE_REDTEAM_REMOTE_GENERATION=true promptfoo redteam run -c promptfooconfig.yaml -j 1 --delay 5000"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "promptfoo": "0.122.2"
  }
}
