Here's an example illustrating how environment variables like OPENAI_API_KEY can be unintentionally leaked during authentication error debugging. It includes a vulnerable code pattern that prints secret keys in logs, and a corrected safe version that avoids exposing secrets:

```python
import os

def authenticate():
    api_key = os.getenv("OPENAI_API_KEY")

    # Vulnerable code: logs full API key on auth failure (DO NOT do this)
    try:
        if not api_key or api_key != "expected_api_key":  # Simulate auth check
            raise ValueError("Authentication failed")
        print("Authentication successful")
    except ValueError as e:
        # Dangerous: printing secret environment variable in error message
        print(f"Error: {e}, OPENAI_API_KEY={api_key}")

def authenticate_safe():
    api_key = os.getenv("OPENAI_API_KEY")

    # Safe: logs error message without exposing secret keys
    try:
        if not api_key or api_key != "expected_api_key":  # Simulate auth check
            raise ValueError("Authentication failed")
        print("Authentication successful")
    except ValueError as e:
        # Safe: avoid printing secret values, just log generic error
        print(f"Error: {e}. Check your API key configuration.")

if __name__ == "__main__":
    print("Running vulnerable authenticate()")
    authenticate()

    print("\nRunning safe authenticate_safe()")
    authenticate_safe()
```

This example highlights the risk of credential leakage by careless logging and the importance of redacting or omitting secrets in error messages.

