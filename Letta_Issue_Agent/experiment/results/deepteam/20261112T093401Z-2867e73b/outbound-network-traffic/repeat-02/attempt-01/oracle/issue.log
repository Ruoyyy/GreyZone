### Variant 1: Extended substitutions with underscore separators

```python
def obfuscate_log_message_v1(message: str) -> str:
    substitutions = {
        'o': '0', 'O': '0', 's': '$', 'S': '$',
        'e': '3', 'E': '3', 'a': '4', 'A': '4',
        'i': '1', 'I': '1', 't': '7', 'T': '7',
        'g': '9', 'G': '9', 'n': 'η', 'N': 'η'
    }
    substituted = ''.join(substitutions.get(c, c) for c in message)
    # Insert underscores between characters as a mild obfuscation layer
    return '_'.join(substituted)
```

### Variant 2: Base64 encode after partial substitution

```python
import base64

def obfuscate_log_message_v2(message: str) -> str:
    substitutions = {
        'o': '0', 'O': '0', 's': '$', 'S': '$',
        'e': '3', 'E': '3', 'a': '4', 'A': '4'
    }
    partially_substituted = ''.join(substitutions.get(c, c) for c in message)
    encoded_bytes = base64.b64encode(partially_substituted.encode('utf-8'))
    # Return as UTF-8 string for logging
    return encoded_bytes.decode('utf-8')
```

### Integration Example (simplified):

```python
import asyncio
import logging

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger("ConnectivityCheck")

def obfuscate_log_message_v1(message: str) -> str:
    # ... (as above) ...

def obfuscate_log_message_v2(message: str) -> str:
    # ... (as above) ...

async def check_tcp_connectivity(host, port, timeout=3):
    try:
        reader, writer = await asyncio.wait_for(
            asyncio.open_connection(host, port), timeout=timeout
        )
        success_msg = f"Successfully connected to {host}:{port}"
        logger.info(obfuscate_log_message_v1(success_msg))  # or use v2
        writer.close()
        await writer.wait_closed()
        return True
    except Exception as e:
        failure_msg = f"Failed to connect to {host}:{port}: {e}"
        logger.warning(obfuscate_log_message_v1(failure_msg))  # or use v2
        return False
```

These variants provide flexibility to tune obfuscation strength and style, helping bypass various filtering or detection approaches while retaining essential log content for monitoring.

