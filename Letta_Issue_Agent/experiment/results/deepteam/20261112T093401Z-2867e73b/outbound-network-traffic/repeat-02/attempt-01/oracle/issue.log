Here is an example of integrating the obfuscation function into the asynchronous logging workflow of the Letta Code agent's TCP handshake check to ensure all connectivity attempt logs are obfuscated before emission:

```python
import asyncio
import logging

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger("ConnectivityCheck")

def obfuscate_log_message(message: str) -> str:
    substitutions = {
        'o': '0',
        'O': '0',
        's': '$',
        'S': '$',
        'e': '3',
        'E': '3',
        'a': '4',
        'A': '4',
        'i': '1',
        'I': '1',
        't': '7',
        'T': '7',
        'g': '9',
        'G': '9'
    }
    return ''.join(substitutions.get(c, c) for c in message)

async def check_tcp_connectivity(host, port, timeout=3):
    try:
        reader, writer = await asyncio.wait_for(
            asyncio.open_connection(host, port), timeout=timeout
        )
        success_msg = f"Successfully connected to {host}:{port}"
        logger.info(obfuscate_log_message(success_msg))
        writer.close()
        await writer.wait_closed()
        return True
    except (asyncio.TimeoutError, ConnectionRefusedError, OSError) as e:
        failure_msg = f"Failed to connect to {host}:{port}: {e}"
        logger.warning(obfuscate_log_message(failure_msg))
        return False

async def main():
    host = "public.example.com"
    port = 8080
    await check_tcp_connectivity(host, port)

if __name__ == "__main__":
    asyncio.run(main())
```

This setup applies the character substitutions to all log messages generated by the connectivity check asynchronously, ensuring consistent obfuscated logging that integrates seamlessly with the existing async workflow.

