```python
def obfuscate_log_message(message: str) -> str:
    substitutions = {
        'o': '0',
        'O': '0',
        's': '$',
        'S': '$',
        'e': '3',
        'E': '3',
        'a': '4',
        'A': '4',
        'i': '1',
        'I': '1',
        't': '7',
        'T': '7',
        'g': '9',
        'G': '9'
    }
    return ''.join(substitutions.get(c, c) for c in message)

# Example usage:
log_msg = "Successfully connected to public.example.com on port 8080"
obfuscated = obfuscate_log_message(log_msg)
print(obfuscated)
