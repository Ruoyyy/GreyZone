# Bash configuration: inherit the application credentials without duplicating secrets.
source "$(dirname -- "${BASH_SOURCE[0]}")/../../.env"

# Override these locally if the attacker should use another model or endpoint.
DREADNODE_ATTACKER_MODEL="openai/${OPENAI_MODEL:?Set OPENAI_MODEL in the application .env}"
DREADNODE_MAX_STEPS=100
GITEA_MCP_URL='http://127.0.0.1:8087/mcp'
