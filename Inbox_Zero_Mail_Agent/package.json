{
  "name": "inbox-zero",
  "private": true,
  "scripts": {
    "build": "turbo build --filter=./apps/web",
    "dev": "turbo dev --filter=./apps/web",
    "worker": "pnpm --filter @inboxzero/worker start",
    "test": "turbo run test --filter=./apps/web -- --run",
    "test-integration": "pnpm --filter inbox-zero-ai test-integration",
    "test:packages": "pnpm -r --filter @inbox-zero/api --filter @inboxzero/email-editor --filter @inboxzero/image-proxy test",
    "lint": "turbo lint",
    "ncu": "ncu -u -ws",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "konsistent": "konsistent",
    "dev-setup": "tsx scripts/dev-setup.ts",
    "docker:local:build": "./docker/scripts/publish-ghcr.sh --local",
    "docker:local:push": "./docker/scripts/publish-ghcr.sh",
    "docker:local:run": "./docker/scripts/run-local.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@turbo/gen": "2.10.12",
    "konsistent": "1.0.0-beta.4",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.23.13",
    "turbo": "2.10.12",
    "ultracite": "7.8.4"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.x"
  }
}
