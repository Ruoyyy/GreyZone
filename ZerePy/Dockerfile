FROM python:3.11-slim

# poetry.lock was generated by Poetry 2.0.1; keep the same version
ENV POETRY_VERSION=2.0.1 \
    POETRY_VIRTUALENVS_CREATE=false \
    PIP_NO_CACHE_DIR=1

RUN pip install --no-cache-dir "poetry==${POETRY_VERSION}"

WORKDIR /app

# Copy the dependency manifests first to use the build cache (the server extra provides FastAPI server mode)
COPY pyproject.toml poetry.lock ./
RUN poetry install --no-root --no-interaction --no-ansi --extras server

# Then copy the source
COPY . .

CMD ["python", "main.py"]
