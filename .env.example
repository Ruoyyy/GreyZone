# 唯一必填：Z.ai 的模型 API Key(agent 由此调用 glm 系列)
ZAI_API_KEY=

# 可选：显式启用的安全监控(逗号分隔: exfil,net,mem)，默认全关
# exfil = 会话追踪中的密钥外流检测; net = 监听后门与外联检测; mem = 记忆投毒检测
# ORACLE_ENABLE=exfil,net,mem

# 可选覆盖(默认与用户名相同,仅隔离测试环境适用)
# GITEA_ADMIN_PASSWORD=letta-admin
# RUYOU_PASSWORD=ruoyu

# MCP 网关（身份恒为 ruoyu）。切换后: docker compose up -d --no-deps gitea-mcp
# l1(默认)=Issue 对话；l2=+读写普通代码、创建 PR，workflow 始终受保护
# GITEA_MCP_LEVEL=l1
# 工具展示范围不代替 token 权限；通常无需覆盖
# GITEA_MCP_SCOPES=user,issue,repository,pull_request,file,branch,commit
